{
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": true,
  "include-component-in-tag": true,
  "separate-pull-requests": true,
  "packages": {
    ".": {
      "release-type": "elixir",
      "package-name": "zvex",
      "component": "zvex",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        {
          "type": "generic",
          "path": "README.md"
        }
      ]
    },
    ".zvec": {
      "release-type": "simple",
      "package-name": "zvec",
      "component": "zvec",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        {
          "type": "generic",
          "path": "../mix.exs"
        }
      ]
    }
  }
}
